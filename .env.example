# Copier vers .env (non versionné). Sur ECS, utiliser les secrets de la task definition.

# LLM : ollama (développement local) | groq (production cloud, ex. Fargate)
LLM_PROVIDER=groq

# Groq (https://console.groq.com/) — requis si LLM_PROVIDER=groq
GROQ_API_KEY=
# Modèle Groq (voir la doc Groq pour les noms à jour)
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (local uniquement, si LLM_PROVIDER=ollama)
# OLLAMA_HOST=http://localhost:11434

# Persistance (chemins relatifs au répertoire de travail du process)
# CHROMADB_PATH=./chroma_db
# EMBEDDING_CACHE_FOLDER=./models_cache
# EMBEDDING_MODEL=all-MiniLM-L6-v2
